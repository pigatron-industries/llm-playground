# LLM Test Harness — environment configuration template.
# Copy to .env (`cp .env.example .env`) and edit. Loaded by run_local.sh.

# --- Provider ---------------------------------------------------------------
# Preset to use: lmstudio | ollama | openai
LLM_PROVIDER=lmstudio

# Override the endpoint / key for any provider (leave commented to use the
# preset defaults from api/config.py).
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_API_KEY=lm-studio

# --- Server -----------------------------------------------------------------
APP_HOST=127.0.0.1
APP_PORT=8080

# Auto-reload the server when source files change (dev convenience).
RELOAD=true

# --- Storage ----------------------------------------------------------------
# Directory for persisted chat JSON files (default: <project>/data/chats).
# CHATS_DIR=data/chats

# --- Image generation API ("Image generation" workflow) ---------------------
# Base URL of the external image API exposing /api/generate and /api/models.
# (default: http://localhost:8070)
IMAGE_API_URL=http://localhost:8070
# Where generated images are saved (default: <project>/data/images).
# IMAGES_DIR=data/images
